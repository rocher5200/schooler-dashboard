# Google Sheets spreadsheet ID used as the formal dashboard data layer.
# Create one spreadsheet and share it with the service account email as Editor.
FORMAL_DATA_SPREADSHEET_ID=replace-with-formal-google-sheets-id

# Password allowed to read dashboard data. This can be shared with dashboard viewers.
DASHBOARD_VIEW_TOKEN=replace-with-view-password

# Password allowed to preview and publish Google Drive sync runs.
SYNC_ADMIN_TOKEN=replace-with-admin-password

# Google Drive Excel file IDs. Share both original Excel files with the service account email as Viewer.
GOOGLE_DRIVE_SALES_FILE_ID=replace-with-sales-excel-file-id
GOOGLE_DRIVE_REFUNDS_FILE_ID=replace-with-refunds-excel-file-id

# Full JSON from a Google Cloud service account.
# It needs readonly access to the original Excel files and edit access to the formal Google Sheets file.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
